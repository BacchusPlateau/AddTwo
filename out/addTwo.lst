    95 				; plot a point (x,y)
    96 				; Step 1: Find which ROW we're on
    97 				;        plotY × 40 = how many bytes to skip to reach our row
    98 				;        (each row is 40 bytes wide)
    99 				;        2^3 + 2^2
   100 				; Step 2: Find which BYTE within that row
   101 				;        plotX ÷ 8 = which byte contains our pixel
   102 				;        (each byte holds 8 pixels)
   103 				;
   104 				; Step 3: Add them together
   105 				;        (plotY × 40) + (plotX ÷ 8) = total byte offset from start of screen RAM
   106 				;
   107 				; Step 4: Add SAVMSC
   108 				;        SAVMSC + offset = actual address in memory of our byte
   109 				;
   110 				; Step 5: Find which BIT within that byte
   111 				;        7 - (plotX mod 8) = which bit is our pixel
   112 				;
   113 				; Step 6: Set that bit
   114 				;        read the byte
   115 				;        OR with our bit mask
   116 				;        write the byte back
   117 				;
   118 303F			        .proc plotPoint
   119
   120 				        ; see multiplyingYby40.txt for full breakdown with an example!
   121
   122 				        ; defeat attract mode on every plot
   123 303F A9 00 85 4D		        mva #0    ATRACT
   124 3043 A9 FF 85 4E		        mva #$FF  ATRMSK
   125
   126 				        ; Step 1: Find which ROW we're on
   127 3047 A5 82		        lda plotY
   128 3049 85 83		        sta temp_lo         ; temp = plotY
   129 304B A9 00		        lda #0
   130 304D 85 84		        sta temp_hi         ; high byte starts at 0
   131
   132 				        ; × 2
   133 304F 06 83		        asl temp_lo         ; shift temp_lo to the left one bit
   134 3051 26 84		        rol temp_hi         ; shift temp_hi to the left one bit and include the carry 
   135
   136 				        ; × 4
   137 3053 06 83		        asl temp_lo
   138 3055 26 84		        rol temp_hi
   139
   140 				        ; × 8  ← save this!
   141 3057 06 83		        asl temp_lo
   142 3059 26 84		        rol temp_hi
   143 305B A5 83		        lda temp_lo
   144 305D 85 87		        sta save_lo
   145 305F A5 84		        lda temp_hi
   146 3061 85 88		        sta save_hi
   147
   148 				        ; × 16
   149 3063 06 83		        asl temp_lo
   150 3065 26 84		        rol temp_hi
   151
   152 				        ; × 32
   153 3067 06 83		        asl temp_lo
   154 3069 26 84		        rol temp_hi
   155
   156 306B A5 83		        lda temp_lo         ; A = temp_lo    (low byte of plotY × 32)
   157 306D 18			        clc                 ; clear carry
   158 306E 65 87		        adc save_lo         ; A = temp_lo + save_lo  (add plotY × 8)
   159 3070 85 83		        sta temp_lo         ; temp_lo = low byte of plotY × 40
   160
   161 3072 A5 84		        lda temp_hi         ; A = temp_hi    (high byte of plotY × 32)
   162 3074 65 88		        adc save_hi         ; A = temp_hi + save_hi + carry  (add high bytes)
   163 3076 85 84		        sta temp_hi         ; temp_hi = high byte of plotY × 40
   164 				        ; we now have the offset to our target row in temp_lo and temp_hi
   165
   166 				        ; calculate which bit 
   167 3078 A5 80		        lda plotX_lo
   168 307A 29 07		        and #%00000111      ; mask bottom 3 bits = plotX mod 8
   169 307C 85 89		        sta bitpos          ; save for Step 5
   170
   171 				        ; Step 2: find offset from start of row to our pixel
   172 				        ; plotX ÷ 8 using 16-bit right shift
   173 				        ; ON ENTRY: plotX_hi/plotX_lo contains X coordinate (0-319)
   174 				        ; ON EXIT:  A contains column byte offset (0-39)
   175 307E 46 81		        lsr plotX_hi        ; shift high byte right, bit 0 → carry
   176 3080 66 80		        ror plotX_lo        ; carry → bit 7 of low byte, bit 0 → carry
   177
   178 3082 46 81		        lsr plotX_hi        ; shift again
   179 3084 66 80		        ror plotX_lo
   180
   181 3086 46 81		        lsr plotX_hi        ; shift again
   182 3088 66 80		        ror plotX_lo        ; plotX_lo now contains plotX ÷ 8
   183
   184 				        ; Step 3: add results from step 1 and 2 together
   185 308A A5 83		        lda temp_lo
   186 308C 18			        clc
   187 308D 65 80		        adc plotX_lo
   188 308F 85 83		        sta temp_lo
   189
   190 3091 A5 84		        lda temp_hi
   191 3093 69 00		        adc #0
   192 3095 85 84		        sta temp_hi
   193 				        ; temp now contains total byte offset from SAVMSC
   194
   195 				        ; Step 4: Add SAVMSC Base Address
   196 3097 A5 83		        lda temp_lo
   197 3099 18			        clc
   198 309A 65 58		        adc SAVMSC
   199 309C 85 85		        sta scrptr_lo
   200
   201 309E A5 84		        lda temp_hi
   202 30A0 65 59		        adc SAVMSC+1
   203 30A2 85 86		        sta scrptr_hi
   204
   205 				        ; Step 5: find which bit to turn on
   206 				        ; algo:  bit position = 7 - (plotX mod 8)
   207 				        ; Step 5: find which bit to turn on
   208 30A4 A9 80		        lda #$80            ; A = %10000000  (start with bit 7)
   209 30A6 A6 89		        ldx bitpos          ; X = number of times to shift right
   210 30A8 F0 04		        beq done_shift      ; if bitpos = 0 no shifting needed!
   211 30AA			shift_loop:
   212 30AA 4A			        lsr                 ; shift A right one position
   213 30AB CA			        dex                 ; X = X - 1
   214 30AC D0 FC		        bne shift_loop      ; if X != 0 keep shifting
   215 30AE			done_shift:
   216 				                            ; A now contains our bit mask
   217
   218 				        ; Step 6: turn on our bit!!
   219 30AE 85 8A		        sta bitmask             ; save mask
   220 30B0 A0 00		        ldy #0                  ; Y = 0 for indirect indexed addressing
   221 30B2 B1 85		        lda (scrptr_lo),y       ; read current byte from screen RAM
   222 30B4 05 8A		        ora bitmask             ; OR with our bit mask (sets our pixel bit)
   223 30B6 91 85		        sta (scrptr_lo),y       ; write modified byte back to screen RAM
   224
   225 30B8 60			        rts
   226 				        .endp
