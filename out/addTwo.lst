    34 2021 4A			        lsr
    35 2022 4A			        lsr 
    36 2023 69 30		        adc #offset_to_char   
    37 2025 20 19 30		        jsr putchar
    38
    39 2028 A5 8D		        lda addResult       ; A = result from above
    40 202A 29 0F		        and #%00001111      ; mask bottom 4 bits to obtain just the right digit
    41 202C 69 30		        adc #offset_to_char
    42 202E 20 19 30		        jsr putchar
