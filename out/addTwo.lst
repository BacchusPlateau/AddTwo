    27 				; =====================================================================
    28 				; CIO (Central I/O) constants
    29 				; CIO is the Atari OS I/O system. We use it to open graphics mode.
    30 				; Each I/O channel uses an IOCB (I/O Control Block) — a fixed block
    31 				; of memory containing command, device, buffer address, and aux bytes.
    32 				; We use IOCB6 (base address $0360) for graphics.
    33 				; X register = $60 tells CIOV which IOCB to use (IOCB6).
    34 				; =====================================================================
    35 = E456			CIOV    = $E456     ; OS CIO entry point — call jsr CIOV to execute
    36 = 0342			ICCOM   = $0342     ; IOCB6 command register
    37 				                    ;   $03 = OPEN   (open a device)
    38 				                    ;   $0C = CLOSE  (close a device)
    39 = 0344			ICBAL   = $0344     ; IOCB6 buffer address low byte
    40 				                    ;   for OPEN: points to device name string "S:"
    41 = 0345			ICBAH   = $0345     ; IOCB6 buffer address high byte
    42 				                    ;   together with ICBAL forms 16-bit pointer to "S:"
    43 = 034A			ICAX1   = $034A     ; IOCB6 auxiliary byte 1
    44 				                    ;   for OPEN: $0C = read/write access mode
    45 = 034B			ICAX2   = $034B     ; IOCB6 auxiliary byte 2
    46 				                    ;   for OPEN: graphics mode number (8 = GR.8)
    47
    48 				; =====================================================================
    49 				; Screen RAM pointer
    50 				; After CIO opens GR.8, the OS stores the address of screen RAM
    51 				; in SAVMSC (two bytes). $58 = low byte, $59 = high byte.
    52 				; On our 800XL PAL system screen RAM ends up at $B060.
    53 				; =====================================================================
    54 = 0058			SAVMSC  = $58       ; zero page address — low byte of screen RAM address
    55 				                    ; $59 automatically contains the high byte
    56
    57 				; =====================================================================
    58 				; Attract mode constants
    59 				; The Atari OS has an attract mode that kicks in after inactivity
    60 				; to prevent screen burn-in. It does this by desaturating all colors
    61 				; making everything appear as shades of grey/blue.
    62 				; We must continuously reset these in our main loop to keep colors!
    63 				; =====================================================================
    64 = 004D			ATRACT  = $4D       ; attract mode counter — OS increments this each frame
    65 				                    ; when it reaches a threshold attract mode activates
    66 				                    ; we keep writing 0 to prevent it from activating
    67 = 004E			ATRMSK  = $4E       ; attract mode color mask
    68 				                    ; OS ANDs all colors with this value
    69 				                    ; $FE strips hue leaving only luminance (grey/blue)
    70 				                    ; $FF = full color (no masking) — what we want
     7 				        icl 'routines.asm'
