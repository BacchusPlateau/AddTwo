    26 201A 18			        clc                 ; clear the carry
    27 201B 69 37		        adc #number2        ; A = A + liter value in number 2
    28 201D 85 8D		        sta addResult       ; memory[addResult] = A
    29
    30 				        ;print both digits, from left to right 
    31 				        ;first digit, shift right four times to move the first digit to the second digit's place
    32 201F 4A			        lsr 
