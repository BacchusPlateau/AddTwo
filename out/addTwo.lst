    32 				; =====================================================================
    33 				; CIO (Central I/O) constants
    34 				; CIO is the Atari OS I/O system. We use it to open graphics mode.
    35 				; Each I/O channel uses an IOCB (I/O Control Block) — a fixed block
    36 				; of memory containing command, device, buffer address, and aux bytes.
    37 				; We use IOCB6 (base address $0360) for graphics.
    38 				; X register = $60 tells CIOV which IOCB to use (IOCB6).
    39 				; =====================================================================
    40 = E456			CIOV    = $E456     ; OS CIO entry point — call jsr CIOV to execute
    41 = 0342			ICCOM   = $0342     ; IOCB6 command register
    42 				                    ;   $03 = OPEN   (open a device)
    43 				                    ;   $0C = CLOSE  (close a device)
    44 = 0344			ICBAL   = $0344     ; IOCB6 buffer address low byte
    45 				                    ;   for OPEN: points to device name string "S:"
    46 = 0345			ICBAH   = $0345     ; IOCB6 buffer address high byte
    47 				                    ;   together with ICBAL forms 16-bit pointer to "S:"
    48 = 034A			ICAX1   = $034A     ; IOCB6 auxiliary byte 1
    49 				                    ;   for OPEN: $0C = read/write access mode
    50 = 034B			ICAX2   = $034B     ; IOCB6 auxiliary byte 2
    51 				                    ;   for OPEN: graphics mode number (8 = GR.8)
    52
    53 				; =====================================================================
    54 				; Screen RAM pointer
    55 				; After CIO opens GR.8, the OS stores the address of screen RAM
    56 				; in SAVMSC (two bytes). $58 = low byte, $59 = high byte.
    57 				; On our 800XL PAL system screen RAM ends up at $B060.
    58 				; =====================================================================
    59 = 0058			SAVMSC  = $58       ; zero page address — low byte of screen RAM address
    60 				                    ; $59 automatically contains the high byte
    61
    62 				; =====================================================================
    63 				; Attract mode constants
    64 				; The Atari OS has an attract mode that kicks in after inactivity
    65 				; to prevent screen burn-in. It does this by desaturating all colors
    66 				; making everything appear as shades of grey/blue.
    67 				; We must continuously reset these in our main loop to keep colors!
    68 				; =====================================================================
    69 = 004D			ATRACT  = $4D       ; attract mode counter — OS increments this each frame
    70 				                    ; when it reaches a threshold attract mode activates
    71 				                    ; we keep writing 0 to prevent it from activating
    72 = 004E			ATRMSK  = $4E       ; attract mode color mask
    73 				                    ; OS ANDs all colors with this value
    74 				                    ; $FE strips hue leaving only luminance (grey/blue)
    75 				                    ; $FF = full color (no masking) — what we want
